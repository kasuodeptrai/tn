                expTitle.textContent = "Chính xác! (+1 điểm)";
                expText.innerHTML = `<span class="font-bold text-emerald-900">Lý do đúng (${letters[q.correct]}):</span> ${q.explanation}`;

            } else {
                // SAI: Tô màu đỏ ô chọn, trừ -1 điểm, đồng thời chỉ ra đáp án đúng màu xanh
