<html lang="vi"><head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>Ôn Thi Triết Học Mác - Lênin</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet">
    <!-- Tone.js for Sound Effects -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* Tùy chỉnh tối ưu cho trải nghiệm trên iPhone 13 và thiết bị di động */
        :root {
            --sat: env(safe-area-inset-top);
            --sab: env(safe-area-inset-bottom);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: #F8FAFC;
            color: #0F172A;
            -webkit-tap-highlight-color: transparent;
            user-select: none;
            overflow-x: hidden;
            padding-top: var(--sat);
            padding-bottom: var(--sab);
        }

        /* Hiệu ứng nút bấm xúc giác */
        .btn-press {
            transition: transform 0.12s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .btn-press:active:not(:disabled) {
            transform: scale(0.97);
        }

        /* Hiệu ứng rung khi trả lời sai */
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-6px); }
            40%, 80% { transform: translateX(6px); }
        }
        .animate-shake {
            animation: shake 0.35s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
        }

        /* Hiệu ứng nảy nhẹ khi trả lời đúng */
        @keyframes pop {
            0% { transform: scale(1); }
            50% { transform: scale(1.02); }
            100% { transform: scale(1); }
        }
        .animate-pop {
            animation: pop 0.25s ease-out;
        }

        /* Hiệu ứng trượt lên cho hộp giải thích */
        @keyframes slideUp {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-slide-up {
            animation: slideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        /* Tùy chỉnh thanh cuộn siêu mảnh */
        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #CBD5E1;
            border-radius: 10px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between bg-slate-50 text-slate-900">

    <!-- Container chính tối ưu chiều rộng chuẩn di động (max-w-md ~ 448px, vừa vặn iPhone 13 390px) -->
    <div id="app" class="w-full max-w-md mx-auto min-h-screen flex flex-col bg-white shadow-xl sm:my-4 sm:min-h-[844px] sm:rounded-[36px] sm:border sm:border-slate-200 overflow-hidden relative">

        <!-- MÀN HÌNH CHỜ (START SCREEN) -->
        <div id="start-screen" class="flex-1 flex flex-col justify-between p-6 bg-gradient-to-b from-indigo-50/80 via-white to-slate-50">
            <div class="pt-6 text-center">
                <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-indigo-600 text-white shadow-lg shadow-indigo-200 mb-5">
                    <i class="fa-solid fa-brain text-3xl"></i>
                </div>
                <span class="inline-block px-3 py-1 rounded-full bg-indigo-100 text-indigo-700 text-xs font-bold tracking-wide uppercase mb-2">
                    Ngân Hàng Đề Thi Tổng Hợp
                </span>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight leading-snug">
                    Triết Học Mác - Lênin
                </h1>
                <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                    Luyện tập trắc nghiệm thông minh với giải thích chi tiết từng đáp án. Tối ưu thao tác một tay.
                </p>
            </div>

            <!-- Thống kê ngân hàng câu hỏi -->
            <div class="my-6 space-y-3">
                <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex items-center gap-4">
                    <div class="w-11 h-11 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center shrink-0 font-bold text-lg">
                        <i class="fa-solid fa-layer-group"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800">20 Câu Ngẫu Nhiên / Màn</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Trộn đều từ bộ <strong>270 câu</strong> và bộ <strong>92 câu</strong> bổ sung.</p>
                    </div>
                </div>

                <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex items-center gap-4">
                    <div class="w-11 h-11 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0 font-bold text-lg">
                        <i class="fa-solid fa-scale-balanced"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800">Cơ Chế Điểm Thưởng &amp; Phạt</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Đúng <span class="text-emerald-600 font-bold">+1 điểm</span> (xanh), Sai <span class="text-rose-600 font-bold">-1 điểm</span> (đỏ).</p>
                    </div>
                </div>

                <div class="p-4 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex items-center gap-4">
                    <div class="w-11 h-11 rounded-xl bg-sky-100 text-sky-600 flex items-center justify-center shrink-0 font-bold text-lg">
                        <i class="fa-solid fa-lightbulb"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold text-slate-800">Giải Thích Sâu Từng Câu</h3>
                        <p class="text-xs text-slate-500 mt-0.5">Phân tích rõ lý do đúng/sai ngay sau khi chọn.</p>
                    </div>
                </div>
            </div>

            <!-- Nút bắt đầu -->
            <div class="pb-4 space-y-3">
                <button onclick="startGame()" class="btn-press w-full py-4 px-6 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-base shadow-lg shadow-indigo-200 flex items-center justify-center gap-2.5">
                    <span>Bắt Đầu Màn Chơi Mới</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
                <div class="flex items-center justify-center gap-2 text-xs text-slate-400">
                    <button id="sound-toggle-start" onclick="toggleSound()" class="flex items-center gap-1.5 py-1.5 px-3 rounded-full hover:bg-slate-100 transition">
                        <i class="fa-solid fa-volume-high text-indigo-500" id="sound-icon-start"></i>
                        <span id="sound-text-start">Âm thanh: Bật</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- MÀN HÌNH CHƠI GAME (QUIZ SCREEN) -->
        <div id="quiz-screen" class="hidden flex-1 flex flex-col h-full">
            <!-- Header cố định trên cùng -->
            <header class="px-5 pt-4 pb-3 bg-white border-b border-slate-100 sticky top-0 z-20">
                <div class="flex items-center justify-between mb-2.5">
                    <button onclick="confirmQuit()" class="w-9 h-9 rounded-xl bg-slate-100 text-slate-600 flex items-center justify-center btn-press" aria-label="Thoát">
                        <i class="fa-solid fa-xmark text-base"></i>
                    </button>

                    <!-- Tiến độ câu hỏi -->
                    <div class="flex flex-col items-center">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Tiến độ</span>
                        <span class="text-sm font-extrabold text-slate-800">
                            Câu <span id="current-q-num" class="text-indigo-600">1</span>/20
                        </span>
                    </div>

                    <!-- Bảng điểm trực tiếp -->
                    <div class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-slate-900 text-white shadow-sm">
                        <i class="fa-solid fa-star text-amber-400 text-xs"></i>
                        <span id="score-display" class="text-sm font-extrabold tabular-nums">0</span>
                    </div>
                </div>

                <!-- Thanh Progress Bar -->
                <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                    <div id="progress-bar" class="h-full bg-indigo-600 rounded-full transition-all duration-300 ease-out" style="width: 5%"></div>
                </div>
            </header>

            <!-- Nội dung câu hỏi & đáp án (Cuộn mượt mà) -->
            <main id="quiz-scroll-area" class="flex-1 overflow-y-auto px-5 py-4 space-y-4">
                
                <!-- Nhãn nguồn file gốc (stt + 270 hoặc stt + 92) -->
                <div class="flex items-center justify-between">
                    <span id="source-badge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-100">
                        <i class="fa-solid fa-file-lines text-[11px]"></i>
                        <span id="source-text">Câu 1 + 270</span>
                    </span>
                    <button onclick="toggleSound()" class="text-slate-400 hover:text-indigo-600 p-1">
                        <i class="fa-solid fa-volume-high text-sm" id="sound-icon-quiz"></i>
                    </button>
                </div>

                <!-- Nội dung câu hỏi -->
                <div class="bg-slate-50/90 p-4 rounded-2xl border border-slate-200/70">
                    <h2 id="question-text" class="text-[17px] font-bold text-slate-900 leading-relaxed">
                        Đang tải câu hỏi...
                    </h2>
                </div>

                <!-- Danh sách 4 đáp án to, dễ bấm -->
                <div id="options-container" class="space-y-3 pt-1">
                    <!-- Các nút đáp án sẽ được render bằng JS -->
                </div>

                <!-- Hộp giải thích chi tiết (Ẩn mặc định, hiện ngay khi chọn đáp án) -->
                <div id="explanation-box" class="hidden animate-slide-up rounded-2xl p-4 border-2 mt-4">
                    <div class="flex items-start gap-3">
                        <div id="exp-icon-wrap" class="w-8 h-8 rounded-xl flex items-center justify-center shrink-0 mt-0.5 text-white font-bold">
                            <i id="exp-icon" class="fa-solid fa-check"></i>
                        </div>
                        <div class="flex-1">
                            <div class="flex items-center justify-between">
                                <h4 id="exp-title" class="font-extrabold text-sm uppercase tracking-wide">Chính xác! (+1 điểm)</h4>
                            </div>
                            <p id="exp-text" class="text-sm leading-relaxed mt-1.5 text-slate-700">
                                Nội dung giải thích sẽ hiển thị ở đây.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Khoảng đệm dưới cùng để không bị che bởi nút Tiếp theo -->
                <div class="h-6"></div>
            </main>

            <!-- Footer chứa nút Câu Tiếp Theo cố định ở dưới đáy (Vùng ngón cái iPhone 13) -->
            <footer id="quiz-footer" class="p-4 bg-white border-t border-slate-100 sticky bottom-0 z-20">
                <button id="next-btn" onclick="nextQuestion()" disabled="" class="btn-press w-full py-4 px-6 rounded-2xl bg-slate-200 text-slate-400 font-bold text-base flex items-center justify-center gap-2 transition-all">
                    <span id="next-btn-text">Chọn một đáp án</span>
                    <i id="next-btn-icon" class="fa-solid fa-hand-pointer"></i>
                </button>
            </footer>
        </div>

        <!-- MÀN HÌNH KẾT QUẢ (RESULT SCREEN) -->
        <div id="result-screen" class="hidden flex-1 flex flex-col justify-between p-6 bg-gradient-to-b from-indigo-50/60 via-white to-slate-50 overflow-y-auto">
            <div class="pt-4 text-center">
                <div id="result-badge-icon" class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-amber-100 text-amber-500 shadow-md mb-4">
                    <i class="fa-solid fa-trophy text-4xl"></i>
                </div>
                <h2 class="text-2xl font-extrabold text-slate-900">Hoàn Thành Màn Chơi!</h2>
                <p id="result-subtitle" class="text-sm text-slate-500 mt-1">Bạn đã hoàn thành 20 câu hỏi ngẫu nhiên.</p>

                <!-- Điểm tổng kết -->
                <div class="mt-6 p-5 rounded-3xl bg-slate-900 text-white shadow-xl relative overflow-hidden">
                    <div class="absolute -right-6 -top-6 w-24 h-24 rounded-full bg-indigo-500/20 blur-xl"></div>
                    <span class="text-xs font-semibold uppercase tracking-widest text-slate-400">Tổng Điểm Đạt Được</span>
                    <div class="text-5xl font-black text-amber-400 my-2 tabular-nums" id="final-score">0</div>
                    <p class="text-xs text-slate-300" id="score-evaluation">Điểm tối đa: 20 điểm</p>
                </div>

                <!-- Chi tiết đúng / sai -->
                <div class="grid grid-cols-2 gap-3 mt-4">
                    <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-center">
                        <div class="text-2xl font-extrabold text-emerald-600" id="correct-count">0</div>
                        <div class="text-xs font-semibold text-emerald-700 mt-0.5">Câu Đúng (+1đ)</div>
                    </div>
                    <div class="p-4 rounded-2xl bg-rose-50 border border-rose-100 text-center">
                        <div class="text-2xl font-extrabold text-rose-600" id="wrong-count">0</div>
                        <div class="text-xs font-semibold text-rose-700 mt-0.5">Câu Sai (-1đ)</div>
                    </div>
                </div>
            </div>

            <!-- Danh sách xem lại nhanh các câu đã làm -->
            <div class="my-5">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2.5">Tóm tắt 20 câu vừa làm</h3>
                <div id="review-list" class="space-y-2 max-h-48 overflow-y-auto pr-1">
                    <!-- Render tóm tắt -->
                </div>
            </div>

            <!-- Nút hành động -->
            <div class="pb-4 space-y-2.5">
                <button onclick="startGame()" class="btn-press w-full py-4 px-6 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-base shadow-lg shadow-indigo-200 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-rotate-right"></i>
                    <span>Chơi Màn Mới (20 Câu Khác)</span>
                </button>
                <button onclick="goHome()" class="btn-press w-full py-3.5 px-6 rounded-2xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm">
                    Về Trang Chính
                </button>
            </div>
        </div>

        <!-- HỘP THOẠI XÁC NHẬN THOÁT (THAY THẾ CONFIRM) -->
        <div id="quit-modal" class="hidden fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-5">
            <div class="bg-white rounded-3xl p-6 max-w-xs w-full shadow-2xl animate-pop">
                <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-xl mb-4">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h3 class="text-lg font-extrabold text-slate-900">Dừng màn chơi?</h3>
                <p class="text-sm text-slate-500 mt-1.5 leading-relaxed">
                    Tiến độ và điểm số của lượt chơi hiện tại sẽ không được lưu lại.
                </p>
                <div class="grid grid-cols-2 gap-2.5 mt-5">
                    <button onclick="closeQuitModal()" class="btn-press py-3 px-4 rounded-xl bg-slate-100 text-slate-700 font-bold text-sm">
                        Chơi tiếp
                    </button>
                    <button onclick="goHome()" class="btn-press py-3 px-4 rounded-xl bg-rose-600 text-white font-bold text-sm">
                        Thoát
                    </button>
                </div>
            </div>
        </div>

    </div>

    <script>
        /**
         * CƠ SỞ DỮ LIỆU CÂU HỎI TỪ 2 FILE GỐC
         * fileType: 270 (từ file Triet-270.pdf) hoặc 92 (từ file TRẮC NGHIỆM BỔ SUNG)
         * originalIndex: Số thứ tự gốc trong file đó
         * Quy tắc hiển thị nhãn: "stt + 270" hoặc "stt + 92"
         */
        const QUESTION_BANK = [
            // ================= FILE 92 CÂU BỔ SUNG =================
            {
                fileType: 92,
                originalIndex: 1,
                question: "Tiền đề lý luận của sự ra đời chủ nghĩa Mác? Chọn câu trả lời đúng",
                options: [
                    "Chủ nghĩa duy vật triết học của Phoiơbắc, Kinh tế học Anh, Chủ nghĩa xã hội không tưởng Pháp",
                    "Triết học biện chứng của Hêghen, Kinh tế chính trị cổ điển Anh, tư tưởng xã hội chủ nghĩa của Pháp",
                    "Kinh tế học của Anh, Chủ nghĩa xã hội Pháp, Triết học cổ điển Đức",
                    "Triết học cổ điển Đức, Kinh tế chính trị cổ điển Anh, Chủ nghĩa xã hội không tưởng Pháp"
                ],
                correct: 3,
                explanation: "Ba nguồn gốc lý luận trực tiếp cấu thành chủ nghĩa Mác là: Triết học cổ điển Đức (Hêghen, Phoiơbắc), Kinh tế chính trị học cổ điển Anh (A.Smith, D.Ricardo) và Chủ nghĩa xã hội không tưởng Pháp (Xanh Ximông, Phuriê, Ôoen). Các phương án khác nêu thiếu chính xác tên gọi hoặc chỉ nêu một bộ phận."
            },
            {
                fileType: 92,
                originalIndex: 2,
                question: "Hình thức nào dưới đây không phải là hình thức cơ bản của chủ nghĩa duy vật?",
                options: [
                    "Chủ nghĩa duy vật chất phác Cổ đại",
                    "Chủ nghĩa duy vật tầm thường",
                    "Chủ nghĩa duy vật siêu hình",
                    "Chủ nghĩa duy vật biện chứng"
                ],
                correct: 1,
                explanation: "Trong lịch sử triết học, chủ nghĩa duy vật phát triển qua 3 hình thức cơ bản: Chủ nghĩa duy vật chất phác (thời Cổ đại), Chủ nghĩa duy vật siêu hình (thế kỷ XVII-XVIII) và Chủ nghĩa duy vật biện chứng (do Mác và Ăngghen sáng lập). 'Chủ nghĩa duy vật tầm thường' là một biến tướng phiến diện chứ không phải hình thức cơ bản."
            },
            {
                fileType: 92,
                originalIndex: 3,
                question: "Tiền đề khoa học tự nhiên của sự ra đời chủ nghĩa Mác? Chọn phương án sai",
                options: [
                    "Định luật bảo toàn và chuyển hoá năng lượng",
                    "Học thuyết tiến hoá",
                    "Học thuyết nguyên tử",
                    "Học thuyết tế bào"
                ],
                correct: 2,
                explanation: "Ba phát minh vĩ đại của khoa học tự nhiên nửa đầu thế kỷ XIX làm tiền đề cho triết học Mác là: Định luật bảo toàn và chuyển hóa năng lượng, Học thuyết tế bào và Học thuyết tiến hóa của Đác-uyn. Học thuyết nguyên tử có từ thời Cổ đại (Đêmôcrit) nên là phương án sai."
            },
            {
                fileType: 92,
                originalIndex: 4,
                question: "Chức năng của triết học mácxít là gì? Chọn câu trả lời đúng",
                options: [
                    "Chức năng làm cầu nối cho các khoa học",
                    "Chức năng làm sáng tỏ cấu trúc ngôn ngữ",
                    "Chức năng khoa học của các khoa học",
                    "Chức năng thế giới quan và phương pháp luận"
                ],
                correct: 3,
                explanation: "Triết học Mác - Lênin có nhiều chức năng, trong đó hai chức năng cơ bản và bao trùm nhất là chức năng thế giới quan (duy vật biện chứng) và chức năng phương pháp luận chung nhất cho hoạt động nhận thức và thực tiễn."
            },
            {
                fileType: 92,
                originalIndex: 5,
                question: "C.Mác đã kế thừa “hạt nhân hợp lý” trong triết học của ông để xây dựng phép biện chứng duy vật. Ông là ai?",
                options: [
                    "Phoiơbắc",
                    "Platôn",
                    "Hêghen",
                    "Ăngghen"
