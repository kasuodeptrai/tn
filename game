                expIconWrap.className = "w-8 h-8 rounded-xl bg-rose-600 flex items-center justify-center shrink-0 mt-0.5 text-white";
                expIcon.className = "fa-solid fa-xmark";
                expTitle.className = "font-extrabold text-sm uppercase tracking-wide text-rose-800";
                expTitle.textContent = "Chưa chính xác! (-1 điểm)";
                expText.innerHTML = `
                    <span class="block mb-1.5 text-rose-900 font-semibold">
                        Bạn đã chọn <strong>${letters[selectedIdx]}</strong> là chưa đúng. Đáp án đúng phải là <strong>${letters[q.correct]}</strong>.
                    </span>
                    <span class="text-slate-800"><strong>Giải thích:</strong> ${q.explanation}</span>
                `;
            }

            // Lưu lịch sử câu này
            sessionHistory.push({
                sttLabel: `Câu ${q.originalIndex} + ${q.fileType}`,
                question: q.question,
                isCorrect: isCorrect,
                userAnswer: letters[selectedIdx],
                correctAnswer: letters[q.correct]
            });

            updateScoreUI();

            // Kích hoạt nút Câu tiếp theo ở chân trang
            const nextBtn = document.getElementById('next-btn');
            nextBtn.disabled = false;
            nextBtn.className = "btn-press w-full py-4 px-6 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-base shadow-lg shadow-indigo-200 flex items-center justify-center gap-2 transition-all cursor-pointer";
            
            if (currentIndex === currentSessionQuestions.length - 1) {
                document.getElementById('next-btn-text').textContent = "Xem Kết Quả Tổng Kết";
                document.getElementById('next-btn-icon').className = "fa-solid fa-flag-checkered";
            } else {
                document.getElementById('next-btn-text').textContent = "Câu Tiếp Theo";
                document.getElementById('next-btn-icon').className = "fa-solid fa-arrow-right";
            }

            // Tự động cuộn nhẹ xuống để thấy trọn vẹn hộp giải thích trên màn hình iPhone 13
            setTimeout(() => {
                expBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }, 120);
        }

        // Chuyển sang câu tiếp theo hoặc kết thúc
        function nextQuestion() {
            if (!answeredCurrent) return;

            if (currentIndex < currentSessionQuestions.length - 1) {
                currentIndex++;
                renderQuestion();
            } else {
                showResults();
            }
        }

        // Hiển thị màn hình tổng kết
        function showResults() {
            playSound('finish');
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');

            const finalScoreEl = document.getElementById('final-score');
            finalScoreEl.textContent = score > 0 ? `+${score}` : score;

            document.getElementById('correct-count').textContent = correctCount;
            document.getElementById('wrong-count').textContent = wrongCount;

            // Đánh giá kết quả
            const evalEl = document.getElementById('score-evaluation');
            const badgeEl = document.getElementById('result-badge-icon');
            if (score >= 16) {
                evalEl.textContent = "Xuất sắc! Bạn nắm rất vững kiến thức Triết học Mác - Lênin.";
                badgeEl.className = "inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-amber-100 text-amber-500 shadow-md mb-4";
            } else if (score >= 10) {
                evalEl.textContent = "Khá tốt! Hãy ôn lại một vài câu nhầm lẫn để đạt điểm tối đa.";
                badgeEl.className = "inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-emerald-100 text-emerald-600 shadow-md mb-4";
            } else if (score >= 0) {
                evalEl.textContent = "Đạt mức trung bình. Cần luyện tập thêm các cặp phạm trù và quy luật.";
                badgeEl.className = "inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-sky-100 text-sky-600 shadow-md mb-4";
            } else {
                evalEl.textContent = "Điểm đang âm do chọn sai nhiều. Hãy đọc kỹ phần giải thích nhé!";
                badgeEl.className = "inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-rose-100 text-rose-500 shadow-md mb-4";
            }

            // Render danh sách tóm tắt 20 câu
            const reviewList = document.getElementById('review-list');
            reviewList.innerHTML = '';
            sessionHistory.forEach((item, index) => {
                const row = document.createElement('div');
                row.className = `p-3 rounded-xl border text-xs flex items-center justify-between gap-2 ${
                    item.isCorrect 
                    ? 'bg-emerald-50/70 border-emerald-200 text-emerald-900' 
                    : 'bg-rose-50/70 border-rose-200 text-rose-900'
                }`;
                row.innerHTML = `
                    <div class="flex items-center gap-2 min-w-0">
                        <span class="font-bold shrink-0">#${index + 1}</span>
                        <span class="px-1.5 py-0.5 rounded bg-white/80 font-bold text-[11px] shrink-0">${item.sttLabel}</span>
                        <span class="truncate text-slate-700">${item.question}</span>
                    </div>
                    <span class="font-extrabold shrink-0">
                        ${item.isCorrect ? '<i class="fa-solid fa-check text-emerald-600"></i> +1' : `<i class="fa-solid fa-xmark text-rose-600"></i> (${item.correctAnswer})`}
                    </span>
                `;
                reviewList.appendChild(row);
            });
        }

        // Xử lý hộp thoại thoát
        function confirmQuit() {
            document.getElementById('quit-modal').classList.remove('hidden');
        }

        function closeQuitModal() {
            document.getElementById('quit-modal').classList.add('hidden');
        }

        function goHome() {
            document.getElementById('quit-modal').classList.add('hidden');
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('start-screen').classList.remove('hidden');
        }
    </script>

</body></html>