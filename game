        // Khởi tạo âm thanh bằng Tone.js (tương tác lần đầu mới bật AudioContext theo quy định Safari iOS)
        function initAudio() {
            if (!synth && typeof Tone !== 'undefined') {
                synth = new Tone.PolySynth(Tone.Synth).toDestination();
                synth.volume.value = -8;
            }
        }

        function playSound(type) {
            if (!soundEnabled) return;
            try {
                initAudio();
                if (Tone.context.state !== 'running') {
                    Tone.context.resume();
                }
                const now = Tone.now();
                if (type === 'correct') {
                    // Hợp âm vui tươi khi trả lời đúng
                    synth.triggerAttackRelease("C5", "16n", now);
                    synth.triggerAttackRelease("E5", "16n", now + 0.08);
                    synth.triggerAttackRelease("G5", "8n", now + 0.16);
                } else if (type === 'wrong') {
                    // Âm trầm báo lỗi nhẹ nhàng
                    synth.triggerAttackRelease("E3", "16n", now);
                    synth.triggerAttackRelease("Eb3", "8n", now + 0.1);
                } else if (type === 'finish') {
                    synth.triggerAttackRelease(["C5", "E5", "G5", "C6"], "4n", now);
                }
            } catch (e) {
                // Bỏ qua lỗi âm thanh nếu trình duyệt chặn
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const iconStart = document.getElementById('sound-icon-start');
            const textStart = document.getElementById('sound-text-start');
            const iconQuiz = document.getElementById('sound-icon-quiz');

            if (soundEnabled) {
                iconStart.className = "fa-solid fa-volume-high text-indigo-500";
                textStart.textContent = "Âm thanh: Bật";
                iconQuiz.className = "fa-solid fa-volume-high text-sm text-indigo-600";
            } else {
                iconStart.className = "fa-solid fa-volume-xmark text-slate-400";
                textStart.textContent = "Âm thanh: Tắt";
                iconQuiz.className = "fa-solid fa-volume-xmark text-sm text-slate-400";
            }
        }

        // Thuật toán xáo trộn Fisher-Yates lấy ngẫu nhiên 20 câu từ cả 2 file
        function pickRandomQuestions(count = 20) {
            const shuffled = [...QUESTION_BANK];
            for (let i = shuffled.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }
            return shuffled.slice(0, Math.min(count, shuffled.length));
        }

        // Bắt đầu màn chơi mới
        function startGame() {
            initAudio();
            currentSessionQuestions = pickRandomQuestions(20);
            currentIndex = 0;
            score = 0;
            correctCount = 0;
            wrongCount = 0;
            sessionHistory = [];

            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('quit-modal').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');

            updateScoreUI();
            renderQuestion();
        }

        // Cập nhật điểm số hiển thị
        function updateScoreUI() {
            const scoreEl = document.getElementById('score-display');
            scoreEl.textContent = score > 0 ? `+${score}` : score;
            if (score > 0) {
                scoreEl.className = "text-sm font-extrabold tabular-nums text-emerald-400";
            } else if (score < 0) {
                scoreEl.className = "text-sm font-extrabold tabular-nums text-rose-400";
            } else {
                scoreEl.className = "text-sm font-extrabold tabular-nums text-white";
            }
        }

        // Hiển thị câu hỏi hiện tại
        function renderQuestion() {
            answeredCurrent = false;
            const q = currentSessionQuestions[currentIndex];

            // Cập nhật tiến độ
            document.getElementById('current-q-num').textContent = currentIndex + 1;
            const progressPercent = ((currentIndex + 1) / currentSessionQuestions.length) * 100;
            document.getElementById('progress-bar').style.width = `${progressPercent}%`;

            // HIỂN THỊ STT GỐC THEO YÊU CẦU: "stt + 270" hoặc "stt + 92"
            const sourceBadge = document.getElementById('source-badge');
            const sourceText = document.getElementById('source-text');
            sourceText.textContent = `Câu ${q.originalIndex} + ${q.fileType}`;
            
            if (q.fileType === 270) {
                sourceBadge.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-indigo-50 text-indigo-700 border border-indigo-200/70";
            } else {
                sourceBadge.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200/70";
            }

            // Hiển thị nội dung câu hỏi
            document.getElementById('question-text').textContent = q.question;

            // Ẩn khung giải thích
            const expBox = document.getElementById('explanation-box');
            expBox.classList.add('hidden');

            // Reset nút Tiếp theo ở footer
            const nextBtn = document.getElementById('next-btn');
            nextBtn.disabled = true;
            nextBtn.className = "btn-press w-full py-4 px-6 rounded-2xl bg-slate-200 text-slate-400 font-bold text-base flex items-center justify-center gap-2 transition-all cursor-not-allowed";
            document.getElementById('next-btn-text').textContent = "Chọn một đáp án";
            document.getElementById('next-btn-icon').className = "fa-solid fa-hand-pointer";

            // Render 4 ô đáp án to, dễ bấm (min-height >= 64px, padding rộng rãi cho ngón tay)
            const container = document.getElementById('options-container');
            container.innerHTML = '';
            const letters = ['A', 'B', 'C', 'D'];

            q.options.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.id = `option-btn-${idx}`;
                btn.type = 'button';
                btn.onclick = () => handleSelectAnswer(idx);
                btn.className = "btn-press w-full text-left p-4 rounded-2xl border-2 border-slate-200 bg-white hover:border-indigo-300 hover:bg-slate-50/80 flex items-start gap-3.5 shadow-2xs min-h-[64px]";

                btn.innerHTML = `
                    <span id="option-letter-${idx}" class="w-8 h-8 rounded-xl bg-slate-100 text-slate-700 font-extrabold text-sm flex items-center justify-center shrink-0 mt-0.5 transition-colors">
                        ${letters[idx]}
                    </span>
                    <span class="text-[15.5px] font-medium text-slate-800 leading-snug flex-1 pt-0.5">
                        ${optText}
                    </span>
                `;
                container.appendChild(btn);
            });

            // Cuộn vùng nội dung về đầu câu hỏi
            document.getElementById('quiz-scroll-area').scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Xử lý khi người dùng bấm chọn một đáp án
        function handleSelectAnswer(selectedIdx) {
            if (answeredCurrent) return;
            answeredCurrent = true;

            const q = currentSessionQuestions[currentIndex];
            const isCorrect = selectedIdx === q.correct;
